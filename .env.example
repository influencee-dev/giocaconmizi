# Gioca con Mizi — variabili d'ambiente
# Copia in .env.local per lo sviluppo. In produzione si impostano su Vercel.
# NON committare mai .env.local: contiene chiavi vere.

# --- Sito ---------------------------------------------------------------
# Usato per canonical, sitemap e redirect del magic link.
NEXT_PUBLIC_SITE_URL=https://giocaconmizi.com

# --- Supabase -----------------------------------------------------------
# Project Settings → API. La anon key è pubblica per progetto: è protetta da RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo server (script di sync, mai esposta al browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- Brevo --------------------------------------------------------------
# Solo server. Sender ID 5, come da piano §7.
BREVO_API_KEY=
BREVO_SENDER_ID=5
BREVO_LIST_GENITORI=
BREVO_LIST_INSEGNANTI=
